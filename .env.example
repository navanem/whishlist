# ==============================================================================
# Configuration Cadeaux (Wishlist Enfants & Famille)
# ==============================================================================

# Port et hôte d'écoute du serveur
PORT=3000
HOSTNAME=0.0.0.0

# Répertoire de persistance des données JSON
DATA_DIR=/app/data

# Paramètres par défaut de la famille (personnalisables dans l'Espace Parents)
FAMILY_NAME="Notre Famille"
CURRENCY="CHF"
PARENT_PIN="1234"
SHARE_TOKEN="notre-famille"

# URL publique de l'application (optionnelle, détectée automatiquement par le navigateur)
# Exemple : https://cadeaux.mondomaine.com
NEXT_PUBLIC_APP_URL=""
